NODE_ENV=development
HOST=0.0.0.0
PORT=4400
DATABASE_URL=postgresql://gap_engine:gap_engine_dev@localhost:5432/gap_engine?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:4400,http://127.0.0.1:4400,http://localhost:3000
PERSISTENCE_DRIVER=memory
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_RETENTION_DAYS=30
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
