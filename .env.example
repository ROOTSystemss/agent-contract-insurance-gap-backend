NODE_ENV=development
HOST=0.0.0.0
PORT=4400
DATABASE_URL=postgresql://gap_engine:gap_engine_dev@localhost:5432/gap_engine?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:4400,http://127.0.0.1:4400,http://localhost:3000
PERSISTENCE_DRIVER=memory
UPLOAD_DIRECTORY=./uploads
DOCUMENT_ENCRYPTION_KEY=
MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=3600000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info

# --- "Sign in with Authority Atlas" bridge (AI Compliance Readiness is the only
# registered client). ATLAS_OAUTH_CLIENT_SECRET must be set to the exact same
# value as ATLAS_CLIENT_SECRET in AI Compliance Readiness's own .env.
ATLAS_OAUTH_CLIENT_ID=ai-compliance-readiness
ATLAS_OAUTH_CLIENT_SECRET=replace-with-at-least-32-random-characters
ATLAS_OAUTH_REDIRECT_URIS=http://localhost:4605/auth/atlas/callback
ATLAS_OAUTH_CODE_TTL_MS=60000
