{
  "name": "agent-contract-insurance-gap-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic API for identifying potential contract and insurance gaps around AI-agent authority.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "node scripts/live-smoke.mjs",
    "test:clean": "node scripts/cleanup-local-smoke-data.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run prisma:validate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node scripts/validate-prisma.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "postgres:backup": "powershell -ExecutionPolicy Bypass -File scripts/configure-postgres-backup.ps1",
    "demo": "npm run build && node dist/demo/run.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@noble/post-quantum": "0.7.1",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "dodopayments": "^2.48.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "mammoth": "^1.10.0",
    "opentimestamps": "^0.4.9",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pino": "^9.9.5",
    "prisma": "^6.12.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^5.0.5",
    "docx": "^9.7.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "qs": "6.16.0",
    "request": "npm:@cypress/request@3.0.10",
    "request-promise": "npm:@cypress/request-promise@5.0.0",
    "@cypress/request": "3.0.10",
    "uuid": "11.1.1",
    "form-data": "4.0.6",
    "bn.js": "4.12.5"
  }
}
